# Project 9 – Modern History & Archival Chronicle Assistant
# Environment Configuration Template

# Path to the primary 50-page historical PDF document
PDF_PATH=data/indian_railways_and_telegraph_history_50p.pdf

# Persistent ChromaDB directory and collection
CHROMA_DB_DIR=chroma_db
COLLECTION_NAME=archival_chronicle

# Lightweight local Sentence Transformer model (runs on CPU)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Hallucination Guardrail & Similarity Thresholds
SIMILARITY_THRESHOLD=0.50
SENTENCE_SIMILARITY_THRESHOLD=0.55
